rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  match /users/{uid} { allow read, write: if signedIn(); }
  match /submissions/{id} { allow read, write: if signedIn(); }
  match /categories/{id} { allow read, write: if signedIn(); }
  match /notifications/{id} { allow read, write: if signedIn(); }
  match /settings/{id} { allow read, write: if signedIn(); }
}}
